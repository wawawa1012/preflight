{
  "name": "preflight-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "contracts": "json2ts -i ../contracts/schema.json -o src/types/contracts.ts --no-additionalProperties"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.1",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "pinia": "^3.0.0",
    "vue-echarts": "^8.0.0",
    "echarts": "^6.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.0.0",
    "json-schema-to-typescript": "^15.0.0"
  }
}
