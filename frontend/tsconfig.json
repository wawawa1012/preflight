{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "skipLibCheck": true,
    "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["vite/client"],
    "paths": {"#build/ui": ["./node_modules/.nuxt-ui/ui"], "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"]}
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "auto-imports.d.ts", "components.d.ts", "vite.config.ts"]
}
